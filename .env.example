# Public browser-safe Supabase values only. Never place service-role credentials here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted server-only key for Auth invitations and private assessment links.
# Never prefix this value with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=

# Canonical public origin (for example https://consulting.leademergence.com).
# Invitation and assessment links use this value instead of the request Host
# header so a forged Host cannot redirect an emailed link to another site.
APP_ORIGIN=

# Local and automated browser tests only. The application rejects fixture mode in production.
E2E_MOCK_AUTH=false
